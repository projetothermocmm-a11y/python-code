plausíveis nos top candidatos,\n","# gerando materiais hipotéticos avaliados pelo modelo treinado.\n","\n","print('=' * 65)\n","print('GERAÇÃO DE CANDIDATOS INÉDITOS')\n","print('=' * 65)\n","\n","# Mapa de substituições isoeletrónicas/isovalentes plausíveis\n","SUBSTITUICOES = {\n","    'Ba': ['Sr', 'Ca'],\n","    'Cu': ['Ni', 'Co', 'Fe'],\n","    'O':  ['S'],\n","    'Bi': ['Sb'],\n","    'Nb': ['Ta', 'V'],\n","    'Zr': ['Hf', 'Ti'],\n","    'In': ['Ga', 'Tl'],\n","    'Sn': ['Ge', 'Si'],\n","}\n","\n","novos_candidatos = []\n","top_base_idx = candidatos.head(20).index\n","\n","for idx in top_base_idx:\n","    row_orig = df_unique.loc[idx]\n","    mat_orig = row_orig['material']\n","\n","    for elem_orig, substitutos in SUBSTITUICOES.items():\n","        if row_orig[elem_orig] <= 0:\n","            continue\n","        for sub in substitutos:\n","            # Ignora substituições que introduzem elementos indesejados\n","            if sub in ELEMENTOS_TOXICOS or sub in TERRAS_RARAS:\n","                continue\n","            if sub not in elem_cols:\n","                continue\n","\n","            nova_comp = row_orig[elem_cols].copy().astype(float)\n","            nova_comp[sub]      = nova_comp[sub] + nova_comp[elem_orig]\n","            nova_comp[elem_orig] = 0.0\n","\n","            # Nome do novo material\n","            novo_nome = mat_orig.replace(elem_orig, sub) if elem_orig in mat_orig \\\n","                        else f'{mat_orig}_sub_{elem_orig}_{sub}'\n","\n","            novos_candidatos.append({\n","                'nome':       novo_nome,\n","                'origem':     mat_orig,\n","                'sub':        f'{elem_orig}→{sub}',\n","                'composicao': nova_comp,\n","                'orig_idx':   idx\n","            })\n","\n","print(f'Variações hipotéticas geradas: {len(novos_candidatos)}')\n","\n","# Predição para cada candidato inédito\n","resultados_novos = []\n","for cand in novos_candidatos:\n","    comp   = cand['composicao']\n","    total  = comp.sum()\n","    if total == 0:\n","        continue\n","\n","    # Recalcula os novos descritores para a composição modificada\n","    X_novo = X.loc[cand['orig_idx']].copy()\n","    X_novo['VEC']            = sum(comp[e] * VALENCE.get(e, 0)       for e in elem_cols) / total\n","    X_novo['eletroneg_pond'] = sum(comp[e] * ELETRONEG.get(e, 0)     for e in elem_cols) / total\n","    X_novo['raio_pond']      = sum(comp[e] * RAIO_ATOMICO.get(e, 0)  for e in elem_cols) / total\n","    ativos = comp[comp > 0]\n","    fracs = (ativos / ativos.sum()).values.astype(float)\n","    X_novo['entropia_config'] = float(-np.sum(fracs * np.log(fracs)))\n","    X_novo['num_elementos']    = float((comp > 0).sum())\n","    X_novo['soma_proporcoes']  = float(total)\n","\n","    tc_pred = float(melhor_modelo.predict(X_novo.values.reshape(1, -1))[0])\n","\n","    # Filtra por critérios de triagem\n","    tem_toxico   = any(comp.get(t, 0) > 0 for t in ELEMENTOS_TOXICOS)\n","    tem_tr       = any(comp.get(r, 0) > 0 for r in TERRAS_RARAS)\n","    if tc_pred > 40 and not tem_toxico and not tem_tr:\n","        resultados_novos.append({\n","            'material':    cand['nome'],\n","            'origem':      cand['origem'],\n","            'substituicao': cand['sub'],\n","            'Tc_Prevista': round(tc_pred, 2)\n","        })\n","\n","if resultados_novos:\n","    df_novos = (pd.DataFrame(resultados_novos)\n","                .sort_values('Tc_Prevista', ascending=False)\n","                .drop_duplicates(subset=['material']))\n","    print(f'Candidatos inéditos que passaram na triagem: {len(df_novos)}')\n","    print('\\nTop 10 Candidatos Inéditos:')\n","    print(df_novos.head(10).to_string(index=False))\n","    df_novos.to_csv('candidatos_ineditos.csv', index=False)\n","    print(\"\\nArquivo 'candidatos_ineditos.csv' exportado com sucesso.\")\n","else:\n","    print('Nenhum candidato inédito passou nos critérios de triagem.')"],"metadata":{"id":"N-swB