 > 40) &\n","    (df_unique['Tc_Prevista'] < 150)\n","].copy()\n","\n","candidatos = candidatos.sort_values('Tc_Prevista', ascending=False)\n","print(f'Candidatos encontrados: {len(candidatos)}')\n","print('\\nTop 10 Supercondutores sem terras raras e sem elementos tóxicos:')\n","print(candidatos[['material', 'critical_temp', 'Tc_Prevista']].head(10).to_string(index=False))"],"metadata":{"id":"tBo8TPWGa7mc","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1782700288376,"user_tz":240,"elapsed":5,"user":{"displayName":"Projeto Thermo","userId":"12370704765373658792"}},"outputId":"d84ece53-b266-4056-90ca-eca55dcdf3bd"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Iniciando triagem de candidatos...\n","Candidatos encontrados: 760\n","\n","Top 10 Supercondutores sem terras raras e sem elementos tóxicos:\n","                   material  critical_temp  Tc_Prevista\n","                   Cu1Cr1O2         132.00   122.760864\n","                       H2S1          60.00   121.331070\n","                       H2S1         185.00   121.331070\n","        Ba2Ca4Cu5C0.4B0.6O3         120.00   118.414688\n"," B0.6C0.4Sr0.5Ba1.5Ca2Cu3O9         119.00   117.617973\n","        Ba2Ca2.4Mg0.6Cu5O12         116.80   117.375481\n","  B0.7C0.3Ba1.5Sr0.5Ca2Cu3O         117.65   117.059944\n","B0.65C0.35Ba1.4Sr0.6Ca2Cu3O         119.60   116.912331\n","   Ag0.25Cu0.75Ba2Ca3Cu4O11         117.10   116.230133\n","      C0.3Ba2Ca4Cu5.7O11.18         117.50   115.643562\n"]}]},{"cell_type":"code","source":["# Therm° Sustentability Score\n","# Quantifica sustentabilidade considerando abundância geológica\n","# e toxicidade, permitindo comparação objetiva entre candidatos.\n","\n","print('=' * 65)\n","print('ÍNDICE DE SUSTENTABILIDADE')\n","print('=' * 65)\n","\n","# Abundância crustal terrestre (ppm, fonte: Taylor & McLennan 1985)\n","ABUNDANCIA = {\n","    'H':1400,'He':0.008,'Li':20,'Be':2.8,'B':10,'C':200,'N':19,'O':461000,\n","    'F':585,'Ne':0,'Na':23600,'Mg':23300,'Al':82300,'Si':282000,'P':1050,\n","    'S':260,'Cl':145,'Ar':0,'K':20900,'Ca':41500,'Sc':22,'Ti':5650,\n","    'V':120,'Cr':102,'Mn':950,'Fe':56300,'Co':25,'Ni':84,'Cu':60,\n","    'Zn':70,'Ga':19,'Ge':1.5,'As':1.8,'Se':0.05,'Br':2.4,'Kr':0,\n","    'Rb':90,'Sr':370,'Y':33,'Zr':165,'Nb':20,'Mo':1.2,'Tc':0,\n","    'Ru':0.001,'Rh':0.0004,'Pd':0.015,'Ag':0.075,'Cd':0.15,\n","    'In':0.25,'Sn':2.3,'Sb':0.2,'Te':0.001,'I':0.45,'Xe':0,\n","    'Cs':3,'Ba':425,'La':39,'Ce':66,'Pr':9.1,'Nd':41,'Pm':0,\n","    'Sm':7.1,'Eu':2,'Gd':6.2,'Tb':1.2,'Dy':5.2,'Ho':1.3,\n","    'Er':3.5,'Tm':0.52,'Yb':3.2,'Lu':0.8,'Hf':3,'Ta':2,\n","    'W':1.3,'Re':0.0007,'Os':0.002,'Ir':0.0004,'Pt':0.004,\n","    'Au':0.0011,'Hg':0.067,'Tl':0.53,'Pb':14,'Bi':0.025,\n","    'Po':0,'At':0,'Rn':0\n","}\n","\n","# Nível de toxicidade (0=seguro, 1=moderado, 2=alto)\n","TOXICIDADE = {e: 0 for e in ABUNDANCIA}\n","TOXICIDADE.update({'Hg':2,'Pb':2,'Tl':2,'As':2,'Cd':2,'Be':2,'Cr':1,'Ni':1,'Co':1,'Sb':1,'Se':1})\n","\n","def calcular_indice_sustentabilidade(row):\n","    fracs = row[elem_cols]\n","    ativos = fracs[fracs > 0]\n","    if ativos.sum() == 0:\n","        return 0.0\n","    total = ativos.sum()\n","    pesos = ativos / total\n","\n","    # Componente de abundância: média ponderada do log10(abundância)\n","    # Faixa real: log10(0.001) ≈ -3  até  log10(461001) ≈ 5.66\n","    abund_vals = np.array([max(ABUNDANCIA.get(e, 0.001), 0.001) for e in ativos.index])\n","    abund_score = float(np.sum(pesos.values * np.log10(abund_vals)))\n","    abund_norm = np.clip((abund_score - (-3)) / (5.7 - (-3)), 0, 1)\n","\n","    # Componente de toxicidade: penalidade ponderada\n","    tox_penalty = float(np.sum(pesos.values * np.array([TOXICIDADE.get(e, 0) for e in ativos.index])))\n","    tox_score = max(0.0, 1.0 - tox_penalty / 2.0)\n","\n","    # Índice combinado (pesos iguais)\n","    return 0.5 * abund_norm + 0.5 * tox_score\n","\n","print('Calculando índice de sustentabilidade para os candidatos...')\n","candidatos['indice_sust'] = candidatos.apply(calcular_indice_sustentabilidade, axis=1)\n","\n","# Score combinado: Tc normalizada (60%) + sustentabilidade (40%)\n","tc_min, tc_max = candidatos['Tc_Prevista'].min(), candidatos['Tc_Prevista'].max()\n","candidatos['Tc_norm'] = (candidatos['Tc_Prevista'] - tc_min) / (tc_max - tc_min + 1e-9)\n","candidatos['score_combinado'] = 0.6 * candidatos['Tc_norm'] + 0.4 * candidatos['indice_sust']\n","candidatos = candidatos.sort_values('score_combinado', ascending=False)\n","\n","print('\\nTop 10 por Score Combinado (Tc + Sustentabilidade):')\n","cols_show = ['material', 'critical_temp', 'Tc_Prevista', 'indice_sust', 'score_combinado']\n","print(candidatos[cols_show].head(10).to_string(index=False))\n","\n","candidatos[cols_show].to_csv('candidatos_alternativos.csv', index=False)\n","print(\"\\nArquivo 'candidatos_alternativos.csv' exportado com sucesso.\")\n","\n","# Gráfico: Tc vs Sustentabilidade (top 30)\n","top30 = candidatos.head(30)\n","fig, ax = plt.subplots(figsize=(10, 6))\n","sc = ax.scatter(top30['indice_sust'], top30['Tc_Prevista'],\n","                c=top30['score_combinado'], cmap='viridis', s=80, edgecolors='k', linewidths=0.5)\n","plt.colorbar(sc, ax=ax, label='Score Combinado')\n","ax.set_xlabel('Índice de Sustentabilidade', fontsize=12)\n","ax.set_ylabel('Tc Prevista (K)', fontsize=12)\n","ax.set_title('Candidatos: Tc Prevista vs. Sustentabilidade (Top 30)', fontsize=13)\n","for _, row in top30.head(5).iterrows():\n","    ax.annotate(row['material'], (row['indice_sust'], row['Tc_Prevista']),\n","                fontsize=7, ha='left', va='bottom', xytext=(4, 2), textcoords='offset points')\n","plt.tight_layout()\n","plt.savefig('reports/sustentabilidade_vs_tc.png', dpi=300)\n","plt.show()\n","print('Gráfico salvo em reports/sustentabilidade_vs_tc.png')"],"metadata":{"id":"0T-QJfYqa8Lx","colab":{"base_uri":"https://localhost:8080/","height":954},"e